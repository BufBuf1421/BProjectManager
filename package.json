{
  "name": "BProjectManager",
  "version": "1.0.4",
  "main": "src/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.buf.bprojectmanager",
    "productName": "BProjectManager",
    "icon": "src/ico/app-icon",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "node_modules/**/*",
      "!node_modules/.bin/**/*",
      "!**/*.test.js",
      "!**/*.spec.js",
      "!**/*.map",
      "!**/*.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/ico/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": true,
      "installerIcon": "src/ico/app-icon.ico",
      "uninstallerIcon": "src/ico/app-icon.ico"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/fs-extra/**/*",
      "node_modules/bcryptjs/**/*",
      "node_modules/@supabase/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^2.4.3",
    "fs-extra": "^11.1.1"
  }
}